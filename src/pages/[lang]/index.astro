---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { liveLangs } from '../../i18n/languages';
import type { Lang } from '../../i18n/languages';
import { t, ranks } from '../../i18n/ui';
import { site } from '../../consts';

export function getStaticPaths() { return liveLangs.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const all = (await getCollection('cases')).filter((c) => c.id.startsWith(`${lang}/`));
const live = all.filter((c) => c.data.status === 'live').sort((a, b) => b.data.number - a.data.number);
const nextSoon = all.filter((c) => c.data.status === 'soon').sort((a, b) => a.data.number - b.data.number)[0];
const latest = [...live.slice(0, 3), ...(nextSoon ? [nextSoon] : [])];
const firstLive = live[live.length - 1]; // lowest-numbered live case
const slug = (id: string) => id.split('/')[1];
---
<Base lang={lang}>
  <div class="hero">
    <div>
      <h1>{t(lang, 'hero.title')}</h1>
      <p>{t(lang, 'hero.sub')}</p>
      {firstLive && <a class="btn f" href={`/${lang}/cases/${slug(firstLive.id)}/`}>{t(lang, 'hero.cta1')}</a>}
      <a class="btn" href={`/${lang}/start/`}>{t(lang, 'hero.cta2')}</a>
    </div>
    <div class="st"><img src="/logo/red-strings-lab-stamp-no-sm.png" width="280" height="280" alt="Red Strings Lab stamp" style="width:100%;height:auto;display:block" /></div>
  </div>

  {site.trailerId && (
    <section class="blk">
      <h2>{t(lang, 'trailer.title')}</h2>
      <div class="video"><iframe src={`https://www.youtube-nocookie.com/embed/${site.trailerId}`} title={t(lang, 'trailer.title')} loading="lazy" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
    </section>
  )}

  <section class="blk">
    <h2>{t(lang, 'latest.title')}</h2>
    <ul class="cases">
      {latest.map((c) => (
        <li class={`case ${c.data.status === 'soon' ? 'soon' : ''}`}>
          <h3>{c.data.title}</h3>
          <p>{c.data.hook}</p>
          {c.data.status === 'live'
            ? <a href={`/${lang}/cases/${slug(c.id)}/`}>{t(lang, 'case.open')}</a>
            : <span class="mute">{t(lang, 'case.soon')}</span>}
        </li>
      ))}
    </ul>
  </section>

  <section class="blk">
    <h2>{t(lang, 'ranks.title')}</h2>
    <ul class="ranks">{ranks.map((r) => <li><b>{t(lang, `rank.${r}`)}</b><span>{t(lang, `rank.${r}.desc`)}</span></li>)}</ul>
    <p class="mute">{t(lang, 'ranks.note')}</p>
  </section>

  <section class="blk">
    <h2>{t(lang, 'signup.title')}</h2>
    <p>{t(lang, 'signup.text')}</p>
    {site.signupUrl
      ? <a class="btn f" href={site.signupUrl}>{t(lang, 'signup.btn')}</a>
      : <><a class="btn f" href={`${site.youtube}?sub_confirmation=1`}>{t(lang, 'signup.subscribe')}</a><p class="mute">{t(lang, 'signup.soon')}</p></>}
  </section>
</Base>
