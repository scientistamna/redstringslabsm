---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { liveLangs } from '../../i18n/languages';
import type { Lang } from '../../i18n/languages';

export async function getStaticPaths() {
  const all = await getCollection('pages');
  return all
    .filter((e) => (liveLangs as string[]).includes(e.id.split('/')[0]))
    .map((entry) => ({ params: { lang: entry.id.split('/')[0], page: entry.id.split('/')[1] }, props: { entry } }));
}
const lang = Astro.params.lang as Lang;
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base lang={lang} title={entry.data.title} description={entry.data.description} path={`${Astro.params.page}/`}>
  <article class="prose"><h1>{entry.data.title}</h1><Content /></article>
</Base>
