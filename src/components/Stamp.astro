---
interface Props { size?: number; id?: string; simple?: boolean; decorative?: boolean; }
const { size = 120, id = 's', simple = false, decorative = false } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 260 260" role={decorative ? undefined : 'img'} aria-label={decorative ? undefined : 'Red String Lab stamp'} aria-hidden={decorative ? 'true' : undefined}>
  {!simple && <defs><path id={`ring-${id}`} d="M130 130 m-92 0 a92 92 0 1 1 184 0 a92 92 0 1 1 -184 0" /></defs>}
  <g transform="rotate(-8 130 130)">
    <circle cx="130" cy="130" r="118" fill="#E63946" />
    <circle cx="130" cy="130" r="111" fill="none" stroke="#fff" stroke-width="2" stroke-dasharray="3 6" />
    <circle cx="130" cy="130" r="64" fill="#0D1321" />
    {!simple && (
      <text font-family="'Special Elite','Courier New',monospace" font-size="21" fill="#fff" textLength="560" lengthAdjust="spacing">
        <textPath href={`#ring-${id}`}>RED STRING LAB • DATA DETECTIVES •</textPath>
      </text>
    )}
    <path d="M100 112 L148 100 L126 158 Q138 170 162 160" fill="none" stroke="#E63946" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
    <g fill="#F4C430"><circle cx="100" cy="112" r="9" /><circle cx="148" cy="100" r="9" /><circle cx="126" cy="158" r="9" /></g>
    <g fill="#0D1321"><circle cx="100" cy="112" r="3" /><circle cx="148" cy="100" r="3" /><circle cx="126" cy="158" r="3" /></g>
  </g>
</svg>
